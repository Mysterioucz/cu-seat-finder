DATABASE_URL=postgres://seat:seat@localhost:5432/seatfinder
JWT_SECRET=dev-secret

# per-service, only relevant when overriding the default in the Makefile's `run`
USER_URL=http://localhost:8081
LIBRARY_URL=http://localhost:8082
OCCUPANCY_URL=http://localhost:8083
RESERVATION_URL=http://localhost:8084
REVIEW_URL=http://localhost:8085

# occupancy service: how often it polls the (mocked) turnstile source, in seconds
POLL_INTERVAL=30
