flowchart LR

    %% Actors (people, not components)
    Customer(["👤 Customer<br/><small>Student / Staff</small>"])
    Admin(["👤 Admin<br/><small>Library staff</small>"])
    Browser["Web Browser<br/><small>mobile / desktop</small>"]

    subgraph Edge["Presentation tier"]
        BFF["Next.js BFF<br/><small>SSR pages + /api/* rewrites<br/>ADR-001</small>"]
    end

    subgraph Services["CU SeatFinder services (Go, ADR-003)"]
        User["User Service<br/><small>Auth, profile, JWT</small>"]
        Library["Library Service · gRPC<br/><small>Libraries, rooms · full CRUD</small>"]
        Occupancy["Occupancy Service<br/><small>Polls, calculates</small>"]
        Reservation["Reservation Service<br/><small>Booking, quota, QR</small>"]
        Review["Review Service · REST<br/><small>Ratings, moderation · full CRUD</small>"]
    end

    DB[("PostgreSQL · Prisma Postgres<br/><small>ADR-006, ADR-008<br/>schemas: users · library · occupancy<br/>reservation · review<br/>each service owns its schema only</small>")]

    SSO["CU SSO · OIDC Provider<br/><small>External · mock IdP in dev, ADR-004</small>"]
    Turnstile["Library Turnstile Systems<br/><small>External · polled, ADR-005</small>"]

    %% Actors use the browser
    Customer --> Browser
    Admin --> Browser
    Browser -- "HTTPS" --> BFF

    %% BFF routes each path prefix to its owning service (REST + JWT)
    BFF -- "REST /api/auth, /api/users" --> User
    BFF == "gRPC (REST facade for browser)" ==> Library
    BFF -- "REST /api/occupancy" --> Occupancy
    BFF -- "REST /api/reservations" --> Reservation
    BFF -- "REST /api/reviews" --> Review

    %% Internal service-to-service (gRPC to Library, REST to User, ADR-007)
    Review -- "REST: viewProfile" --> User
    Review == "gRPC: GetLibrary" ==> Library
    Reservation -- "REST: viewProfile" --> User
    Reservation == "gRPC: GetRoom" ==> Library
    Occupancy == "gRPC: GetLibrary" ==> Library

    %% Each service reads/writes only its own schema
    Services -- "SQL (pgx), schema-per-service" --> DB

    %% External integrations
    User -. "OIDC login" .-> SSO
    Occupancy -. "poll (time.Ticker)" .-> Turnstile

    classDef actor fill:#FFFFFF,stroke:#993C1D,color:#712B13
    classDef client fill:#FFFFFF,stroke:#5F5E5A,color:#444441
    classDef caller fill:#EEEDFE,stroke:#534AB7,color:#3C3489
    classDef core fill:#E1F5EE,stroke:#0F6E56,color:#085041
    classDef db fill:#E6F1FB,stroke:#185FA5,color:#0C447C
    classDef external fill:#F1EFE8,stroke:#5F5E5A,color:#444441

    class Customer,Admin actor
    class Browser,BFF client
    class Review,Reservation,Occupancy caller
    class User,Library core
    class DB db
    class SSO,Turnstile external

    style Edge fill:#FAECE7,stroke:#993C1D,stroke-dasharray:5 3
    style Services fill:#F7F6F2,stroke:#5F5E5A,stroke-dasharray:5 3

    linkStyle 4,9,11,12 stroke:#3B6D11,stroke-width:2px
